package-manager=pnpm

# ============================================================
# uni-app 官方推荐的 pnpm 兼容配置（解决 @dcloudio 工具链要求）
# ============================================================
#
# 背景：@dcloudio/vite-plugin-uni、@dcloudio/uni-cli-shared 等包内部
# 使用相对路径 require 兄弟包（如 ../../../uni-cli-shared/dist），依赖于扁平化
# 的 node_modules 结构。pnpm 默认严格隔离（.pnpm/ store）下此相对路径会解
# 析错位，报 "Cannot find module '../../../uni-cli-shared/dist'。
#
# 修复：shamefully-hoist + hoisted linker + public-hoist 强制 @dcloudio/*
# 全部升到顶层 node_modules，模拟 npm/yarn classic 扁平化结构。
# ============================================================

shamefully-hoist=true
node-linker=hoisted
public-hoist-pattern[]=@dcloudio/*
public-hoist-pattern[]=vue
public-hoist-pattern[]=vite
public-hoist-pattern[]=pinia
public-hoist-pattern[]=esbuild
public-hoist-pattern[]=rollup
public-hoist-pattern[]=@vitejs/*
public-hoist-pattern[]=@vue/*

# 自动补齐 peer，不阻塞启动：@dcloudio 对 peer 版本多且有大量 peer mismatch（版本警告多，
# 不应当当成错误中止；自动补齐 peer dependencies=true
strict-peer-dependencies=false

# 允许执行已批准的 scripts：esbuild 等需要 postinstall 下载本地二进制
enable-pre-post-scripts=true
