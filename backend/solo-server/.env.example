# Solo Life OS backend environment variables.
# Copy to .env and adjust as needed. .env is git-ignored (see .gitignore).
# These values are consumed via ${VAR:default} placeholders in application.yml.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solo_life_os
DB_USERNAME=solo
DB_PASSWORD=solo123

# Connection pool (HikariCP)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Flyway migration location.
# Default points to repo-root database/migrations/ (run app from repo root).
# If running from backend/solo-server/, set:
#   FLYWAY_LOCATIONS=filesystem:../../../database/migrations
FLYWAY_LOCATIONS=filesystem:database/migrations
